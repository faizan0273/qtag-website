# ============================================================
#  Qtag — Environment Variables
#  Copy to .env.local for development, .env.production for prod
# ============================================================

# --- Application ----------------------------------------------
# Public URL where this app is deployed. Used in QR codes printed on stickers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Development / LAN phone testing --------------------------
# QR codes use this when set (e.g. http://192.168.1.132:3000). Restart dev after change.
# NEXT_PUBLIC_QR_BASE_URL=http://192.168.1.132:3000
# Show OTP in API responses on staging (dev always exposes when NODE_ENV=development).
# OTP_TEST_EXPOSE_CODE=true
# Optional: force fast OTP UI outside NODE_ENV=development.
# NEXT_PUBLIC_DEV_FAST_OTP=true
# Optional: default tag for post-login redirect in embed prod (not used in dev — dev uses /dev/qr).
# NEXT_PUBLIC_DEFAULT_TAG_UID=devar7kp

# Used in branded WhatsApp/SMS messages.
NEXT_PUBLIC_BRAND_NAME=Qtag
# Displayed on relay messages (your WhatsApp Business line), e.g. 03261548853
# NEXT_PUBLIC_COMPANY_CONTACT_PHONE=03261548853

# --- Database -------------------------------------------------
# MongoDB connection string. Use Atlas in production.
MONGODB_URI=mongodb+srv://immuhammadfaizan:5vA0Livpt4x5tc47@cluster0.2mi8ygj.mongodb.net/

# --- Auth -----------------------------------------------------
# 32+ character random string. Generate with: openssl rand -hex 32
JWT_SECRET=e88005b8ebff93cc337c95ff8a7cdd74b8daf0816121199777d630bd932b672e
# Access token TTL (e.g. "15m", "1h", "7d")
JWT_ACCESS_TTL=7d

# --- WhatsApp (Meta Cloud API) --------------------------------
# Leave blank in dev — OTPs will print to the server console.
# In production, get these from https://developers.facebook.com/apps
WHATSAPP_PHONE_NUMBER_ID=1028616307009129
WHATSAPP_ACCESS_
# Approved template names (set up in Meta Business Manager)
WHATSAPP_OTP_TEMPLATE=Qtag OTP
WHATSAPP_SCAN_ALERT_TEMPLATE=Qtag ALERT
# Template language. "en" or "ur" once you have an Urdu template approved.
WHATSAPP_TEMPLATE_LANG=en

# --- SMS (fallback, optional) ---------------------------------
# Used only if WhatsApp delivery fails. Provider-agnostic.
# Configure your provider in src/lib/sms.ts.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Order configuration --------------------------------------
# Single-product MVP price (in PKR, integer)
PRODUCT_PRICE_PKR=599
SHIPPING_FEE_PKR=200
FREE_SHIPPING_THRESHOLD_PKR=1500
COD_FEE_PKR=50

# --- Rate limits (tweak with care) ----------------------------
RATE_LIMIT_OTP_PER_PHONE_PER_15M=3
RATE_LIMIT_OTP_PER_IP_PER_HOUR=10
RATE_LIMIT_CONTACT_PER_IP_PER_HOUR=20
RATE_LIMIT_CALL_PER_IP_PER_HOUR=10

# --- WebRTC private browser calls -----------------------------
# Audio calls use browser WebRTC. STUN is enough for many networks; TURN improves reliability.
NEXT_PUBLIC_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# --- Optional: admin bootstrap --------------------------------
# A comma-separated list of phone numbers (E.164) that get ADMIN role on first login.
ADMIN_PHONES=

# --- JazzCash (HTTP Post / Page Redirection) ------------------
# Credentials issued by JazzCash. Keep these SECRET — never commit prod values.
JAZZCASH_MERCHANT_ID=MC743732
JAZZCASH_PASSWORD=999040g32u
JAZZCASH_INTEGRITY_SALT=4w212ua9xs
# Set to "false" to hit the live JazzCash endpoint. Default sandbox.
JAZZCASH_USE_SANDBOX=true
# Optional override of the JazzCash hosted-checkout endpoint. Leave blank to
# auto-pick sandbox/production based on JAZZCASH_USE_SANDBOX.
JAZZCASH_POST_URL=
# Where JazzCash will POST the result back. Must be publicly reachable.
# Leave blank to use `${NEXT_PUBLIC_APP_URL}/api/payments/jazzcash/return`.
JAZZCASH_RETURN_URL=https://incondite-kaye-partakable.ngrok-free.dev/api/payments/jazzcash/return